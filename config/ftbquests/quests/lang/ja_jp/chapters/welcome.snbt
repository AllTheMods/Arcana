{
	quest.0C93D7A607AB8B83.quest_desc: [
		"チャンクを主張するには、&6M&rを使用してマップを開き、左上の&aClaim Map&rアイコンをクリックします。"
		""
		"チャンクを主張するには、左クリックしてドラッグします。"
		""
		"チャンクを強制的にロードするには、シフトを押しながらチャンクを左クリックします。正しく行えば、チャンク全体に線が表示されます。"
	]
	quest.0C93D7A607AB8B83.title: "チャンクの主張"
	quest.3708A4780ACEB34E.quest_desc: [
		"このモッドパックでは、クエストは任意です。モッドはクエストの完了に依存していません！"
		""
		"メインクエストライン以外の個々のクエストラインは、モッドのガイドとして機能します。進行を追いたい場合は、メインクエストラインを確認してください！"
		""
		"パック内のクエストのほとんども&2AlfredGG&rによって作られています。クエストは大変な作業なので、彼をサポートしたい場合は、下の彼のプレイヤー画像をクリックしてください！"
	]
	quest.3708A4780ACEB34E.title: "クエスト"
	quest.3BC0A50886A3222B.quest_desc: [
		"ATM10はキッチンシンクパックで、あなた自身のやり方でモッド化されたマインクラフトの世界を探索することができます！"
		""
		"&lATM10は現在、モッドパック開発のベータ段階にあります&r。更新に伴い、モッドが追加または削除されます。"
		""
		"何か質問や問題があれば、ご遠慮なくATMのDiscordに参加してください！"
	]
	quest.3BC0A50886A3222B.title: "&dAll The Mods 10へようこそ！"
	quest.5AC1BE754210429E.quest_desc: ["あなたとあなたの友人のためのチームを作りたいなら、コマンド&a/ftbteams party create (チームの名前)&rを使ってチームを作成してください！"]
	quest.5AC1BE754210429E.title: "チーム作成"
	quest.7658C1C663394E85.quest_desc: [
		"ATMにはたくさんの便利なコマンドがあります。以下にいくつかを紹介します: "
		""
		"&e/sethome&r (ホームの名前) | ホームを設定して、/home (名前)を使ってテレポートできます。例: /sethome farm - そして/home farmでテレポート "
		""
		"&e/spawn&r | これはあなたをオーバーワールドのスポーンにテレポートします。 "
		""
		"&e/rtp&r | 'ランダムテレポート'はあなたを世界のランダムな場所にテレポートします。 "
		""
		"注意: これらのコマンドにはクールダウンと制限があります。それらを変更したい場合は、以下にある設定ファイルを編集できます: "
		""
		"- シングルプレイヤー用 | &osaves/(セーブの名前)/serverconfig/ftbessentials.snbt&r "
		""
		"- サーバー用 | &oworld/serverconfig/ftbessentials.snbt&r"
	]
	quest.7658C1C663394E85.title: "便利なコマンド"
}
