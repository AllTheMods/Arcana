	]
	quest.196E55B64667AE35.quest_subtitle: "Slapping down a Slab"
	quest.198EDBAC1D6E2339.quest_desc: ["You'll need these for Ender Bees."]
	quest.198EDBAC1D6E2339.quest_subtitle: "Prevents Bees from Teleporting in a Hive"
	quest.1A0672C7509271B3.quest_subtitle: "Feed Fluorite to a Diamond Bee"
	quest.1A0672C7509271B3.title: "Fluorite Bee"
	quest.1A4FAE5705B53753.quest_subtitle: "Crafted with Enchanting Apparatus"
	quest.1A4FAE5705B53753.title: "Air Essence Bee"
	quest.1B79F794EDAA810A.quest_desc: ["The Breeding Chamber can be used to breed two bees with each other, automatically. It is capable of self breeding, as well as breeding 2 types of bees to make a third type (Example: Ashy Mining + Crystalline -> Iron). If this would result in a conflict (Continuing off of the earlier example, Ashy Mining + Crystalline -> Aluminium), take out one of the bees, then put it back in.\\n\\nProvide breeding items in each slot (usually flowers, hold SHIFT on a bee cage holding a certain bee type to see what breeding item it uses (Draconic Bees use 2 Draconic Dust for example)) and some bee cages.\\n\\nJust...don't do...whatever it takes to get the F.Bee.I. to go after you. I will ensure you get added to the Hall of Shame if they DO come after you."]
	quest.1B79F794EDAA810A.quest_subtitle: "Making Babies 2: Electric Beegaloo"
	quest.1C40B30823B2A254.quest_subtitle: "Just fish for it"
	quest.1C40B30823B2A254.title: "Prismarine Bee"
	quest.1C474B46AECCCFE9.quest_subtitle: "Spawned using a Gravel or Stone Nest"
	quest.1D720AC88431BD70.quest_desc: ["Breed the Ender Bee with a Lapis Bee to create a Diamond Bee!"]
	quest.1D720AC88431BD70.quest_subtitle: "Ender + Lapis"
	quest.1D720AC88431BD70.title: "Diamond Bee"
