	quest.3054D016D2EF25FF.title: "Electrum Bee"
	quest.309059DEDEE7AECD.quest_desc: ["Collects items on the ground and brings it back to it's nest."]
	quest.309059DEDEE7AECD.quest_subtitle: "Feed a Collector Bee a Shulker Shell"
	quest.309059DEDEE7AECD.title: "Hoarder Bee"
	quest.30A238E87F013CBB.quest_desc: ["Bees have varying traits that can affect how they work, when they work, their aggression, and their likelihood to lose their stinger when they attack you. In these quests I will be going over the way to get the best traits possible, as well as how to use them.\\n\\nTo get these Gene Samples, check out the Bottler quest, which is a dependency of this one. To actually apply these Gene Samples to your bees, you will need to combine them with a Honey Treat in a crafting grid. All traits, except for Type, you can apply to your bees by feeding them the Honey Treat. Type works differently, and must instead be used with the Incubator to make a Spawn Egg of the respective bee."]
	quest.30A238E87F013CBB.quest_subtitle: "To make the ultimate bee"
	quest.30A238E87F013CBB.title: "Gene Samples"
	quest.3155E4212045BC8E.quest_desc: [
		"The Obsidian Nest will lure in Draconic Bees when placed in the End."
		""
		"These do not accept Honey Treats, but instead use Dragon's Breath."
	]
	quest.3155E4212045BC8E.quest_subtitle: "Lures a Draconic Bee in the End"
	quest.31ED0C236C41A837.quest_subtitle: "Feed a Lava Bucket to a Magmatic Bee"
	quest.31ED0C236C41A837.title: "Lava Bee"
	quest.32FDC5FFA000DAF8.quest_desc: ["Proud of the Bees you have?\\n\\nWanna put them into a jar to show it off?\\n\\nPlace a Bee Jar down and use a Pipe or Hopper to insert the caged Bee into the jar."]
	quest.32FDC5FFA000DAF8.quest_subtitle: "Showing Off Bees"
	quest.33422FBDAE11AE82.quest_subtitle: "Feed a Spatial Bee a Fluix Pearl"
	quest.33422FBDAE11AE82.title: "Fluix Bee"
	quest.33A0E06FE5CFD8F3.quest_desc: ["The &9Centrifuge&r is used to process Combs from Bees into useful items and honey! While you can definitely just use a regular &9Centrifuge&r in the beginning, getting a &6Powered Centrifuge&r soon after is a must. This is a faster Centrifuge that runs off of power!\\n\\nIf you're looking for the best way to process your Combs, the &cHeated Centrifuge&r is even faster and processes &aComb Blocks&r instead of Combs!\\n\\nThese can all be made faster by using Speed Upgrades."]
	quest.33A0E06FE5CFD8F3.quest_subtitle: "Processing Honeycombs"
	quest.3466C70EB256026B.quest_subtitle: "Crafted with Enchanting Apparatus"
	quest.3466C70EB256026B.title: "Fire Essence Bee"
	quest.349D19F2FCC34B84.quest_desc: ["Placing the Nether Brick Nest in the Nether will lure in a Magmatic Bee when given Magma Cream."]
	quest.349D19F2FCC34B84.quest_subtitle: "Lures in a Magmatic Bee when placed in the Nether"
	quest.3567306F2B66BD20.quest_subtitle: "Infusion Crafting"
	quest.3567306F2B66BD20.title: "Imperium Bee"
	quest.35E8F1CC0080E45E.quest_subtitle: "Feed a Diamond Bee a Ruby"
	quest.35E8F1CC0080E45E.title: "RuBee"
