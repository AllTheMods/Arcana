	quest.664F1B4ECFD8706D.quest_subtitle: "&8Infusing Attacks with Power&r"
	quest.664F1B4ECFD8706D.title: "&l&cApplying Effects&r"
	quest.6660229C55EE32D4.quest_desc: [
